---
import { siteConfig } from "../site.config";
---

<section aria-label="Credibility" class="surface-card not-prose overflow-hidden sm:flex sm:flex-row divide-y sm:divide-y-0 sm:divide-x divide-border/60 motion-safe:transition-colors motion-safe:duration-200 hover:border-border-muted">
  {
    siteConfig.credibility.map(({ label, detail }) => (
      <div class="flex-1 min-w-0 px-5 py-5 sm:px-6 sm:py-6 first:pt-5 sm:first:pt-6">
        <p class="text-[11px] uppercase tracking-[0.14em] text-accent/90 m-0 mb-2">{label}</p>
        <p class="text-sm text-ink-muted m-0 leading-relaxed">{detail}</p>
      </div>
    ))
  }
</section>
